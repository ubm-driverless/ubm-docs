      <memberdef kind="variable" id="constants_8hpp_1ad494329bee2902da03f43a0dad726215" prot="public" static="no" constexpr="yes" mutable="no">
        <type>constexpr uint32_t</type>
        <definition>constexpr uint32_t MIN_FAILSAFE_WAY_SIZE</definition>
        <argsstring></argsstring>
        <name>MIN_FAILSAFE_WAY_SIZE</name>
        <initializer>= 2</initializer>
        <briefdescription>
<para>Minimum number of midpoints ahead of the car so that a failsafe is not triggered. </para>
        </briefdescription>
        <detaileddescription>
<para><itemizedlist>
<listitem><para>If set to 1: the failsafe will be activated only when the car does not have any midpoints ahead.</para>
</listitem><listitem><para>If set to 2: the failsafe will be activated when the car has still one midpoint ahead. This option may be preferrable.</para>
</listitem><listitem><para>Any bigger value will trigger the failsafe sooner. </para>
</listitem></itemizedlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="include/utils/constants.hpp" line="48" column="20" bodyfile="include/utils/constants.hpp" bodystart="48" bodyend="-1"/>
