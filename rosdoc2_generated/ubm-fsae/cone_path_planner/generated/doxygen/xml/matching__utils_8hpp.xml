      <memberdef kind="function" id="matching__utils_8hpp_1afcb56065ad5ddcd3a5182b27a1c2448d" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>arma::fvec</type>
        <definition>arma::fvec angles_from_matrix</definition>
        <argsstring>(const arma::fmat &amp;mat)</argsstring>
        <name>angles_from_matrix</name>
        <param>
          <type>const arma::fmat &amp;</type>
          <declname>mat</declname>
        </param>
        <briefdescription>
<para>Computes the angles (in radians) between consecutive row vectors of a matrix. </para>
        </briefdescription>
        <detaileddescription>
<para>This function takes a matrix where each row is a vector and calculates the angle between each pair of consecutive rows using the dot product formula. The result is a vector of angles in radians, with one fewer element than the number of rows in the input matrix.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>mat</parametername>
</parameternamelist>
<parameterdescription>
<para>A matrix (<computeroutput>arma::fmat</computeroutput>) where each row represents a vector. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>A vector (<computeroutput>arma::fvec</computeroutput>) containing the angles in radians between each pair of consecutive row vectors.</para>
</simplesect>
<simplesect kind="note"><para>The function clamps the cosine values to [-1, 1] to avoid domain errors in <computeroutput>acos</computeroutput>. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
